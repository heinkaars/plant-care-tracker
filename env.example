# Existing var, keep as-is
OPENAI_API_KEY=your_openai_api_key_here

# Safe to expose to the browser: Row Level Security protects the data, not
# the secrecy of these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-side only. Bypasses row level security, used by lib/api-guard.ts to
# write the rate-limit counter (which clients may not write). Must never gain
# a NEXT_PUBLIC_ prefix.
#
# Supabase dashboard -> Project Settings -> API Keys -> Secret keys.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Server-side only. How many proxies sit in front of the app (Vercel: 1),
# so the rate limiter knows how far into x-forwarded-for the real caller
# address is. Local development: leave unset.
TRUSTED_PROXY_HOPS=1
